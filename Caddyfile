:80 {
	root * /srv
	encode zstd gzip
	file_server

	# Experiments are shared by link, never through a search engine.
	header {
		X-Robots-Tag "noindex, nofollow, noarchive, noimageindex"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	handle_errors {
		rewrite * /404.html
		file_server {
			status {err.status_code}
		}
	}
}
